{
  "env": {
    "browser": true,
    "es2021": true
  },
  "globals": {
    "lucide": "readonly"
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "script"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off",
    "no-inner-declarations": "off",
    "no-case-declarations": "off"
  }
}
